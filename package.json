{
    "name": "wp-react",
    "version": "1.0.9",
    "description": "A modern, type-safe React toolkit for headless WordPress with REST and GraphQL support.",
    "author": "Farahmand Moslemi",
    "license": "MIT",
    "homepage": "https://wp-react.js.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FarahmandM/wp-react.git"
    },
    "bugs": {
        "url": "https://github.com/FarahmandM/wp-react/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "bin": {
        "wp-react-cli": "./dist/cli/index.js"
    },
    "scripts": {
        "build": "npm run clean && rollup -c && tsc-alias",
        "postbuild": "chmod +x ./dist/cli/index.js",
        "dev": "rollup -c -w",
        "test": "jest --coverage",
        "update-license-years": "ts-node src/scripts/update-license-years.ts",
        "prepublishOnly": "npm run update-license-years && npm run build && npm run test",
        "lint": "eslint src",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
        "typecheck": "tsc --noEmit",
        "cli": "ts-node src/cli/index.ts",
        "clean": "rm -rf ./dist ./coverage"
    },
    "keywords": [
        "wp-react",
        "react",
        "wp",
        "wordpress",
        "headless",
        "headless-wordpress",
        "rest-api",
        "wp-rest-api",
        "graphql",
        "wp-graphql",
        "hooks",
        "typescript",
        "jwt",
        "authentication",
        "react-query",
        "cli"
    ],
    "peerDependencies": {
        "@tanstack/react-query": "^5.102.4",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^12.1.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/express": "^5.0.3",
        "@types/inquirer": "^9.0.8",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.13.3",
        "@types/react": "^19.1.4",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "express": "^5.1.0",
        "inquirer": "^14.0.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.4.1",
        "open": "^11.0.1",
        "prettier": "^3.9.6",
        "react": "^19.0.0",
        "react-dom": "^19.2.8",
        "rollup": "^4.63.0",
        "rollup-plugin-typescript-paths": "^1.5.0",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.8",
        "tsconfig-paths": "^4.2.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.0"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/sdk-trace-web": "^2.10.0",
        "@tanstack/react-query": "^5.102.4",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@types/inquirer": "^9.0.8",
        "axios": "^1.19.0",
        "dompurify": "^3.4.13",
        "graphql-request": "^7.1.2"
    },
    "overrides": {
        "form-data": "^4.0.6",
        "js-yaml": "^4.3.1",
        "dompurify": "^3.4.13"
    }
}
